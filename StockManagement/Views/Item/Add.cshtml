@model StockManagement.Models.ViewModels.ItemAddModel;

<div class="bg-secondary bg-opacity-10">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center p-2">
            <div>
                <h4 class="m-0">Add New Item</h4>
            </div>
            <div>
                
            </div>
        </div>
    </div>
</div>
<div class="container">
    <form method="post">
        <div class="row mb-3">
            <div class="col-6">
                <label class="form-label" for="code">Code</label>
                <input asp-for="Code" class="form-control" type="text" id="code"/>
            </div>
            <div class="col-6">
                <label class="form-label" for="name">Name</label>
                <input asp-for="Name" class="form-control" type="text" id="name"/>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-6">
                <label class="form-label" for="cost">Cost</label>
                <input asp-for="Cost" class="form-control" type="text" id="cost"/>
            </div>
            <div class="col-6">
                <label class="form-label" for="price">Price</label>
                <input asp-for="Price" class="form-control" type="text" id="price"/>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-6">
                <label class="form-label" for="unit">Unit</label>
                <select asp-for="UnitId" class="form-select" id="unit">
                    <option value="1">Can</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label" for="itemType">ItemType</label>
                <select asp-for="ItemTypeId" class="form-select" id="itemType">
                    <option value="1">Water</option>
                </select>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-6">
                <label class="form-label" for="image">Image</label>
                <input asp-for="Image" class="form-control" type="text" id="image"/>
            </div>
            <div class="col-6">
                <label class="form-label" for="isStock">IsStock</label>
                <input asp-for="IsStock" class="form-check" type="checkbox" id="isStock"/>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-12">
                <label class="form-label" for="note">Note</label>
                <input asp-for="Note" class="form-control" type="text" id="note"/>
            </div>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary me-3">Save</button>
            <a asp-area="" asp-controller="Item"
               asp-action="List"
               class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>